# Root reference template — copy to frontend/.env and backend/.env as needed.

# Frontend (frontend/.env)
# Leave empty in local dev to use Vite's /api proxy; set to deployed backend URL on Vercel.
VITE_API_URL=http://localhost:5000

# Backend (backend/.env)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pms
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

