{
  "name": "pms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const {spawn}=require('child_process');const c=process.platform==='win32'?'npm.cmd':'npm';spawn(c,['--prefix','frontend','run','dev'],{stdio:'inherit',shell:true});spawn(c,['--prefix','backend','run','dev'],{stdio:'inherit',shell:true});\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  }
}
